---
import { getCategories } from "../../lib/queries";
import { imageUrl, sectorImage } from "../../lib/media";
import { services } from "../../lib/services";
import Arrow from "../ui/Arrow.astro";
const categories = await getCategories();
---

<section class="service-list">
  <div class="wrap">
    {categories.map((category, index) => (
      <article class="service-row" data-reveal>
        <div class="service-count">0{index + 1} / UZMANLIK</div>
        <div class="service-copy">
          <h2>{category.title}</h2>
          <p>{category.description}</p>
          <ul>
            {(services[category.slug] || []).map((service) => (
              <li>{service}</li>
            ))}
          </ul>
          <a class="text-link" href={`/${category.slug}/`}>
            Sektörü ve projeleri keşfedin <Arrow />
          </a>
        </div>
        <figure class="photo service-photo">
          <img
            src={imageUrl(
              category.coverImage,
              1000,
              sectorImage(category.slug),
            )}
            alt={category.coverImage?.alt || `${category.title} çalışma alanı`}
            width="1000"
            height="800"
            loading="lazy"
          />
          {!category.coverImage?.asset && (
            <span class="photo-credit">Temsili görsel</span>
          )}
        </figure>
      </article>
    ))}
  </div>
</section>
<style>
  .service-list {
    padding-bottom: var(--section-space);
  }
  .service-row {
    display: grid;
    grid-template-columns: 130px 1fr 1fr;
    gap: 45px;
    border-top: 1px solid var(--color-line);
    padding-block: 55px 65px;
  }
  .service-count {
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    padding-top: 12px;
  }
  .service-copy h2 {
    font-size: 45px;
  }
  .service-copy > p {
    font-size: 13px;
    margin-top: 24px;
    max-width: 380px;
  }
  .service-copy ul {
    list-style: none;
    padding: 0;
    margin: 30px 0;
  }
  .service-copy li {
    font-size: 12px;
    border-bottom: 1px solid var(--color-line);
    padding: 12px 0;
    display: flex;
    gap: 15px;
  }
  .service-copy li::before {
    content: "↳";
    color: var(--color-accent);
  }
  .service-copy .text-link {
    font-size: 11px;
  }
  .service-photo {
    height: 430px;
    align-self: center;
  }
  @media (max-width: 1000px) {
    .service-row {
      grid-template-columns: 1fr 1fr;
      gap: 24px 40px;
    }
    .service-count {
      grid-column: 1/-1;
    }
  }
  @media (max-width: 650px) {
    .service-row {
      grid-template-columns: 1fr;
      padding-top: 30px;
    }
    .service-copy h2 {
      font-size: 37px;
    }
    .service-photo {
      height: 310px;
      margin-top: 15px;
    }
  }
  @media (max-width: 700px) {
    .service-copy > p {
      font-size: 14px;
    }
    .service-copy li {
      font-size: 13px;
    }
  }
</style>
