---
const groups = [
	{
		title: 'Mekanik',
		href: '/mekanik/',
		items: [
			'Mekanik Tesisat',
			'Boru Hattı Montajı',
			'Ekipman Montajı ve Devreye Alma',
			'Bakım ve Revizyon',
		],
	},
	{
		title: 'Tarım',
		href: '/tarim/',
		items: [
			'Sulama Sistemleri',
			'Tarımsal Depolama Çözümleri',
			'Traktör ve Makine Bakımı',
			'Sera Altyapı Sistemleri',
		],
	},
];
---

<section class="what-we-do">
	<div class="inner">
		<p class="eyebrow">Ne Yapıyoruz</p>
		<h2>Sahada ürettiğimiz somut çözümler.</h2>
		<p class="lead">
			İş kollarımızın altında, sahada karşılığı olan somut hizmetler sunuyoruz — keşiften teslime
			kadar uçtan uca sorumluluk alıyoruz.
		</p>

		<div class="groups">
			{
				groups.map((group) => (
					<div class="group">
						<h3>{group.title}</h3>
						<ul class="links">
							{group.items.map((item) => (
								<li>
									<a href={group.href}>{item}</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.what-we-do {
		background: var(--color-ink);
		color: var(--color-on-dark);
	}

	.inner {
		max-width: var(--container);
		margin-inline: auto;
		padding: var(--space-7) var(--container-pad);
	}

	.eyebrow {
		margin: 0 0 var(--space-3);
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--color-harvest);
	}

	h2 {
		max-width: 20ch;
		margin: 0 0 var(--space-3);
		color: var(--color-on-dark);
	}

	.lead {
		max-width: 56ch;
		margin: 0;
		font-size: var(--text-lg);
		color: var(--color-steel-light);
	}

	.groups {
		display: grid;
		gap: var(--space-6);
		margin-top: var(--space-7);
	}

	.group h3 {
		margin: 0 0 var(--space-3);
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--color-steel-light);
	}

	.links {
		display: grid;
		gap: var(--space-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.links a {
		display: inline-flex;
		align-items: baseline;
		gap: var(--space-2);
		color: var(--color-on-dark);
		font-size: var(--text-lg);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: border-color var(--transition);
	}

	.links a::after {
		content: '→';
		color: var(--color-harvest);
		opacity: 0;
		transform: translateX(-4px);
		transition:
			opacity var(--transition),
			transform var(--transition);
	}

	.links a:hover {
		border-bottom-color: var(--color-steel-light);
	}

	.links a:hover::after {
		opacity: 1;
		transform: none;
	}

	@media (min-width: 900px) {
		.groups {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-7);
		}
	}
</style>
