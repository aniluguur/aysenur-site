---
import { getProjects } from "../../lib/queries";
import ProjectCard from "../projects/ProjectCard.astro";
import Arrow from "../ui/Arrow.astro";
const projects = (await getProjects()).slice(0, 4);
---

<section class="section featured" data-carousel>
  <div class="wrap">
    <div class="section-top">
      <p class="eyebrow">Sahadan seçtiklerimiz</p>
      <span class="section-index">03 / PROJELER</span>
    </div>
    <div class="featured-heading" data-reveal>
      <h2>
        İşimizi, yaptığımız
        <br />
        işler anlatır.
      </h2>
      <a class="text-link" href="/projeler">
        Tüm projeler <Arrow />
      </a>
    </div>
    <div
      class="project-track"
      tabindex="0"
      aria-label="Seçilmiş projeler, yatay kaydırılabilir"
      data-track
    >
      {projects.map((project, index) => (
        <div class="project-slide">
          <ProjectCard project={project} index={index} />
        </div>
      ))}
    </div>
    <div class="carousel-bottom">
      <div class="track-progress" aria-hidden="true">
        <span data-progress></span>
      </div>
      <div class="carousel-controls">
        <button aria-label="Önceki projeler" data-prev>
          <span>←</span>
        </button>
        <button aria-label="Sonraki projeler" data-next>
          <span>→</span>
        </button>
      </div>
    </div>
  </div>
</section>
<style>
  .featured {
    overflow: hidden;
  }
  .featured-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 48px;
  }
  .featured-heading > .text-link {
    margin-bottom: 7px;
  }
  .project-track {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 10px;
  }
  .project-track::-webkit-scrollbar {
    display: none;
  }
  .project-slide {
    flex: 0 0 calc(50% - 30px);
    scroll-snap-align: start;
    min-width: 0;
  }
  .project-slide:nth-child(even) {
    padding-top: 65px;
  }
  .carousel-bottom {
    display: flex;
    align-items: center;
    gap: 35px;
    margin-top: 37px;
  }
  .track-progress {
    height: 1px;
    background: var(--color-line);
    flex: 1;
    overflow: hidden;
  }
  .track-progress span {
    display: block;
    height: 1px;
    width: 25%;
    background: var(--color-ink);
    transform-origin: left;
    transition: width 0.15s;
  }
  .carousel-controls {
    display: flex;
    gap: 10px;
  }
  .carousel-controls button {
    height: 42px;
    width: 42px;
    border: 1px solid var(--color-line);
    background: transparent;
    display: grid;
    place-items: center;
    font-size: 20px;
    transition: background 0.2s;
  }
  .carousel-controls button:hover:not(:disabled) {
    background: var(--color-ink);
    color: white;
  }
  .carousel-controls button:disabled {
    opacity: 0.3;
    cursor: default;
  }
  @media (max-width: 700px) {
    .featured-heading {
      align-items: start;
      gap: 25px;
    }
    .featured-heading > .text-link {
      font-size: 10px;
      gap: 20px;
      flex-shrink: 0;
    }
    .project-track {
      gap: 20px;
    }
    .project-slide {
      flex-basis: 85%;
    }
    .project-slide:nth-child(even) {
      padding-top: 0;
    }
    .featured-heading h2 {
      font-size: 34px;
    }
  }
  @media (max-width: 420px) {
    .featured-heading {
      display: block;
    }
    .featured-heading > .text-link {
      margin-top: 20px;
    }
    .project-slide {
      flex-basis: 90%;
    }
  }
</style>
<script>
  document
    .querySelectorAll<HTMLElement>("[data-carousel]")
    .forEach((section) => {
      const track = section.querySelector<HTMLElement>("[data-track]")!;
      const progress = section.querySelector<HTMLElement>("[data-progress]")!;
      const prev = section.querySelector<HTMLButtonElement>("[data-prev]")!;
      const next = section.querySelector<HTMLButtonElement>("[data-next]")!;
      const update = () => {
        const max = track.scrollWidth - track.clientWidth;
        prev.disabled = track.scrollLeft < 2;
        next.disabled = track.scrollLeft >= max - 2;
        progress.style.width = `${max <= 0 ? 100 : 25 + (75 * Math.max(0, track.scrollLeft)) / max}%`;
      };
      const move = (direction: number) => {
        const slide = track.firstElementChild as HTMLElement | null;
        const gap = parseFloat(getComputedStyle(track).gap) || 0;
        track.scrollBy({
          left: direction * ((slide?.offsetWidth || track.clientWidth) + gap),
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
            .matches
            ? "auto"
            : "smooth",
        });
      };
      prev.addEventListener("click", () => move(-1));
      next.addEventListener("click", () => move(1));
      track.addEventListener("scroll", update, { passive: true });
      new ResizeObserver(update).observe(track);
      update();
    });
</script>
