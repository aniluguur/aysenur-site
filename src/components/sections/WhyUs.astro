---
const values = [
	{
		title: 'Mühendislik Kalitesi',
		description: 'Her projeyi teknik standartlara uygun, doğru mühendislikle hayata geçiriyoruz.',
	},
	{
		title: 'Zamanında Teslim',
		description: 'Belirlediğimiz takvime bağlı kalarak işi söz verdiğimiz sürede tamamlıyoruz.',
	},
	{
		title: 'Saha Deneyimi',
		description: 'Hem mekanik hem tarım alanında edindiğimiz saha bilgisiyle fark yaratıyoruz.',
	},
	{
		title: 'Teslim Sonrası Destek',
		description: 'Proje tesliminden sonra da bakım ve destekle yanınızda olmaya devam ediyoruz.',
	},
];
---

<section class="why-us">
	<div class="inner">
		<h2>Neden Biz?</h2>

		<ul class="grid">
			{
				values.map((value) => (
					<li class="card">
						<h3>{value.title}</h3>
						<p>{value.description}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.why-us {
		background: var(--color-surface);
	}

	.inner {
		max-width: var(--container);
		margin-inline: auto;
		padding: var(--space-7) var(--container-pad);
	}

	.grid {
		display: grid;
		gap: var(--space-5);
		margin: var(--space-6) 0 0;
		padding: 0;
		list-style: none;
	}

	.card {
		padding: var(--space-5);
		background: var(--color-surface-alt);
		border-radius: var(--radius-md);
	}

	.card h3 {
		margin: 0 0 var(--space-2);
		font-size: var(--text-lg);
		color: var(--color-ink);
	}

	.card p {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-steel);
	}

	@media (min-width: 900px) {
		.grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
