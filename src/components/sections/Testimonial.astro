---
import { getHomePage } from '../../lib/queries';

const homePage = await getHomePage();
const quote = homePage?.testimonialQuote ?? '';
const authorName = homePage?.testimonialAuthorName ?? '';
const authorCompany = homePage?.testimonialAuthorCompany ?? '';
---

<section class="testimonial">
	<div class="inner">
		<blockquote class="card">
			<p class="quote">"{quote}"</p>
			<footer class="attribution">{authorName}, {authorCompany}</footer>
		</blockquote>
	</div>
</section>

<style>
	.testimonial {
		background: var(--color-surface);
	}

	.inner {
		max-width: var(--container);
		margin-inline: auto;
		padding: var(--space-7) var(--container-pad);
	}

	.card {
		max-width: 60ch;
		margin: 0 auto;
		padding: var(--space-6);
		background: var(--color-surface-alt);
		border: var(--border-hairline);
		border-radius: var(--radius-md);
		text-align: center;
	}

	.quote {
		margin: 0 0 var(--space-3);
		font-size: var(--text-lg);
		font-style: italic;
		color: var(--color-graphite);
	}

	.attribution {
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-steel);
	}
</style>
