---
import { getHomePage } from "../../lib/queries";
import { hasContent } from "../../lib/media";
const home = await getHomePage();
const valid =
  hasContent(home?.testimonialAuthorName) && hasContent(home?.testimonialQuote);
---

{valid && (
  <section class="testimonial section">
    <div class="wrap">
      <p class="eyebrow">Birlikte başardık</p>
      <blockquote data-reveal>
        <span class="quote-mark" aria-hidden="true">
          “
        </span>
        <p>{home?.testimonialQuote}</p>
        <footer>
          {home?.testimonialAuthorName}
          <span>
            {hasContent(home?.testimonialAuthorCompany)
              ? home?.testimonialAuthorCompany
              : ""}
          </span>
        </footer>
      </blockquote>
    </div>
  </section>
)}
<style>
  .testimonial {
    background: var(--color-surface-alt);
  }
  blockquote {
    margin: 35px auto 0;
    max-width: 850px;
    text-align: center;
  }
  .quote-mark {
    font-size: 100px;
    color: var(--color-accent);
    line-height: 1;
  }
  blockquote > p {
    font-size: clamp(25px, 3vw, 42px);
    color: var(--color-ink);
    letter-spacing: -0.04em;
    line-height: 1.4;
  }
  blockquote footer {
    font-size: 12px;
    margin-top: 30px;
  }
  blockquote footer span {
    display: block;
    color: var(--color-steel);
    font-size: 10px;
    margin-top: 5px;
  }
</style>
