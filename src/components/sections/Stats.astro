---
import { getHomePage } from "../../lib/queries";
import { hasContent } from "../../lib/media";
const home = await getHomePage();
const stats = (home?.stats || []).filter((stat) => hasContent(stat.value));
const principles = [
  { value: "Sahaya özel", label: "Her projenin kendi çözümü" },
  { value: "Uçtan uca", label: "Planlamadan uygulamaya" },
  { value: "Birlikte", label: "Teslim sonrasında da yanınızda" },
];
const items = stats.length ? stats : principles;
---

<section
  class="proof-strip"
  aria-label={stats.length ? "Rakamlarla şirketimiz" : "Çalışma yaklaşımımız"}
>
  <div class="wrap proof-inner">
    {items.map((item, index) => (
      <div class="proof-item">
        <span class="proof-number">0{index + 1}</span>
        <div>
          <strong>{item.value}</strong>
          <p>{item.label}</p>
        </div>
      </div>
    ))}
  </div>
</section>
<style>
  .proof-strip {
    border-bottom: 1px solid var(--color-line);
  }
  .proof-inner {
    display: flex;
    padding-block: 36px;
    gap: 30px;
  }
  .proof-item {
    flex: 1;
    display: flex;
    gap: 20px;
    padding-left: 30px;
    border-left: 1px solid var(--color-line);
  }
  .proof-item:first-child {
    border: 0;
    padding-left: 0;
  }
  .proof-number {
    font-size: 9px;
    color: var(--color-accent);
    padding-top: 5px;
  }
  .proof-item strong {
    font-size: 24px;
    font-weight: 400;
    letter-spacing: -0.04em;
  }
  .proof-item p {
    font-size: 10px;
    margin-top: 4px;
  }
  @media (max-width: 700px) {
    .proof-inner {
      gap: 18px;
      padding-block: 25px;
    }
    .proof-item {
      padding-left: 16px;
      gap: 0;
      display: block;
    }
    .proof-number {
      display: block;
      margin-bottom: 8px;
    }
    .proof-item strong {
      font-size: 17px;
    }
    .proof-item p {
      font-size: 9px;
      line-height: 1.5;
    }
  }
  @media (max-width: 400px) {
    .proof-inner {
      gap: 12px;
    }
    .proof-item {
      padding-left: 12px;
    }
    .proof-item strong {
      font-size: 15px;
    }
  }
</style>
