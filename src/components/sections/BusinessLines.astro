---
import { getCategories } from "../../lib/queries";
import { imageUrl, sectorImage } from "../../lib/media";
import Arrow from "../ui/Arrow.astro";
const categories = await getCategories();
---

<section class="section business-lines" data-business-lines>
  <div class="wrap">
    <div class="section-top">
      <p class="eyebrow">Uzmanlığımız</p>
      <span class="section-index">02 / ÇALIŞMA ALANLARI</span>
    </div>
    <div class="business-heading" data-reveal>
      <h2>
        Farklı sahalar.
        <br />
        <span>Aynı titizlik.</span>
      </h2>
      <p>
        İhtiyacın olduğu yerde, doğru bilgi ve uygulama deneyimiyle çözüm
        üretiyoruz.
      </p>
    </div>
    <div class="business-layout">
      <div class="sector-tabs" role="tablist" aria-label="Çalışma alanları">
        {categories.map((category, index) => (
          <button
            role="tab"
            id={`tab-${category.slug}`}
            aria-controls={`panel-${category.slug}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-index={index}
          >
            <span class="tab-number">0{index + 1}</span>
            <span>{category.title}</span>
            <Arrow />
          </button>
        ))}
      </div>
      <div class="sector-panels">
        {categories.map((category, index) => (
          <article
            role="tabpanel"
            id={`panel-${category.slug}`}
            aria-labelledby={`tab-${category.slug}`}
            tabindex="0"
            hidden={index !== 0}
            class="sector-panel"
          >
            <div class="sector-description">
              <p class="sector-label">PROJE & UYGULAMA</p>
              <h3>{category.title}</h3>
              <p>{category.description}</p>
              <a href={`/${category.slug}/`} class="text-link">
                Bu alanı keşfedin <Arrow />
              </a>
            </div>
            <figure class="photo sector-photo">
              <img
                src={imageUrl(
                  category.coverImage,
                  1200,
                  sectorImage(category.slug),
                )}
                alt={
                  category.coverImage?.alt || `${category.title} çalışma alanı`
                }
                width="1200"
                height="900"
                loading="lazy"
              />
              {!category.coverImage?.asset && (
                <span class="photo-credit">Temsili görsel</span>
              )}
            </figure>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .business-lines {
    background: var(--color-ink);
    color: var(--color-on-dark);
    --color-line: #ffffff26;
  }
  .business-lines .eyebrow {
    color: var(--color-on-dark);
  }
  .business-lines .eyebrow::before {
    background: #d79f78;
  }
  .business-lines .section-index {
    color: #aeb7ab;
  }
  .business-heading {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    align-items: end;
    margin-bottom: 64px;
  }
  .business-heading h2 span {
    color: #a4b29e;
  }
  .business-heading > p {
    max-width: 310px;
    font-size: 12px;
    line-height: 1.9;
    color: #b5beb2;
  }
  .business-layout {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    gap: 45px;
  }
  .sector-tabs {
    display: flex;
    flex-direction: column;
  }
  .sector-tabs button {
    background: none;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    padding: 24px 0;
    display: flex;
    align-items: center;
    text-align: left;
    gap: 16px;
    color: #abb4a6;
    font-size: 21px;
    line-height: 1.2;
  }
  .sector-tabs button:first-child {
    border-top: 1px solid var(--color-line);
  }
  .sector-tabs button[aria-selected="true"] {
    color: white;
  }
  .tab-number {
    font-size: 9px;
    color: #b4bcad;
  }
  .sector-tabs :global(svg) {
    width: 17px;
    height: 17px;
    margin-left: auto;
    opacity: 0;
    transform: translateX(-6px);
    transition: all 0.3s;
  }
  .sector-tabs button[aria-selected="true"] :global(svg) {
    opacity: 1;
    transform: none;
    color: #deaa86;
  }
  .sector-panel {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 38px;
    align-items: center;
    animation: panel-in 0.55s var(--ease);
  }
  .sector-label {
    font-size: 8px;
    letter-spacing: 0.16em;
    color: #d5a585;
    margin-bottom: 22px;
  }
  .sector-description h3 {
    font-size: 32px;
  }
  .sector-description > p:not(.sector-label) {
    color: #b5beb2;
    font-size: 12px;
    line-height: 1.95;
    margin-top: 22px;
  }
  .sector-description .text-link {
    margin-top: 32px;
    font-size: 10px;
    width: 100%;
  }
  .sector-description .text-link:hover {
    color: #deaa86;
  }
  .sector-photo {
    height: 360px;
  }
  .sector-photo img {
    transition: transform 1s var(--ease);
  }
  .sector-photo:hover img {
    transform: scale(1.04);
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 1100px) {
    .business-layout {
      grid-template-columns: 190px 1fr;
      gap: 30px;
    }
    .sector-panel {
      gap: 24px;
      grid-template-columns: 1fr 1fr;
    }
    .sector-photo {
      height: 340px;
    }
  }
  @media (max-width: 850px) {
    .business-heading {
      margin-bottom: 35px;
    }
    .business-layout {
      display: block;
    }
    .sector-tabs {
      flex-direction: row;
      gap: 25px;
      overflow-x: auto;
      margin-bottom: 35px;
    }
    .sector-tabs button {
      flex-shrink: 0;
      font-size: 20px;
      padding: 18px 0;
      gap: 10px;
      border-top: 0 !important;
    }
    .sector-tabs :global(svg) {
      display: none;
    }
    .sector-tabs button[aria-selected="true"] {
      border-bottom-color: #d5a585;
    }
    .sector-panel {
      grid-template-columns: 1fr 1.2fr;
    }
    .sector-description h3 {
      font-size: 30px;
    }
  }
  @media (max-width: 550px) {
    .business-heading {
      display: block;
    }
    .business-heading > p {
      margin-top: 25px;
    }
    .sector-tabs {
      gap: 22px;
    }
    .sector-tabs button {
      font-size: 17px;
    }
    .tab-number {
      font-size: 8px;
    }
    .sector-panel {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .sector-photo {
      height: 300px;
    }
    .sector-description .text-link {
      width: auto;
      gap: 40px;
      margin-top: 22px;
    }
    .sector-description > p:not(.sector-label) {
      max-width: 380px;
    }
    .sector-label {
      margin-bottom: 15px;
    }
  }
  @media (max-width: 700px) {
    .business-heading > p,
    .sector-description > p:not(.sector-label) {
      font-size: 14px;
    }
    .sector-description .text-link {
      font-size: 12px;
    }
  }
</style>
<script>
  document
    .querySelectorAll<HTMLElement>("[data-business-lines]")
    .forEach((section) => {
      const tabs = Array.from(
        section.querySelectorAll<HTMLButtonElement>("[role=tab]"),
      );
      const panels = Array.from(
        section.querySelectorAll<HTMLElement>("[role=tabpanel]"),
      );
      const select = (index: number, focus = false) => {
        tabs.forEach((tab, i) => {
          tab.setAttribute("aria-selected", String(i === index));
          tab.tabIndex = i === index ? 0 : -1;
        });
        panels.forEach((panel, i) => (panel.hidden = i !== index));
        if (focus) tabs[index].focus();
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => select(index));
        tab.addEventListener("keydown", (event) => {
          let next = index;
          if (event.key === "ArrowRight" || event.key === "ArrowDown")
            next = (index + 1) % tabs.length;
          else if (event.key === "ArrowLeft" || event.key === "ArrowUp")
            next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = tabs.length - 1;
          else return;
          event.preventDefault();
          select(next, true);
        });
      });
    });
</script>
