---
import { getCategories } from '../../lib/queries';

const categories = await getCategories();
---

<section class="business-lines" data-business-lines>
	<div class="inner">
		<h2>İş Kollarımız</h2>

		<div class="layout">
			<ul class="list">
				{
					categories.map((category, index) => (
						<li>
							<button
								class:list={['item', { 'is-active': index === 0 }]}
								type="button"
								aria-current={index === 0 ? 'true' : undefined}
								aria-controls={`business-line-${category.slug}`}
								data-target={category.slug}
							>
								<span class="index">{String(index + 1).padStart(2, '0')}</span>
								<span class="label">{category.title}</span>
							</button>
						</li>
					))
				}
			</ul>

			<div class="panels">
				{
					categories.map((category, index) => (
						<article
							class="panel"
							id={`business-line-${category.slug}`}
							data-slug={category.slug}
							hidden={index === 0 ? undefined : true}
						>
							<div class="copy">
								<p class="eyebrow">İş Kolu</p>
								<h3>{category.title}</h3>
								<p class="description">{category.description}</p>
								<a class="cta" href={`/${category.slug}/`}>İncele</a>
							</div>
							<div class="visual" aria-hidden="true"></div>
						</article>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.business-lines {
		background: var(--color-surface);
	}

	.inner {
		max-width: var(--container);
		margin-inline: auto;
		padding: var(--space-7) var(--container-pad);
	}

	.layout {
		display: grid;
		gap: var(--space-6);
		margin-top: var(--space-6);
	}

	.list {
		display: flex;
		gap: var(--space-2);
		list-style: none;
		margin: 0;
		padding: 0;
		border-bottom: var(--border-hairline);
	}

	.list li {
		flex: 1;
	}

	.item {
		display: flex;
		align-items: baseline;
		gap: var(--space-2);
		width: 100%;
		padding: var(--space-3) 0;
		background: none;
		border: 0;
		border-bottom: 2px solid transparent;
		margin-bottom: -1px;
		font-family: var(--font-display);
		color: var(--color-steel);
		text-align: left;
		cursor: pointer;
		transition:
			color var(--transition),
			border-color var(--transition);
	}

	.item .index {
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
	}

	.item .label {
		font-size: var(--text-base);
		font-weight: var(--weight-medium);
	}

	.item:hover {
		color: var(--color-graphite);
	}

	.item.is-active {
		color: var(--color-accent-strong);
		border-bottom-color: var(--color-accent);
	}

	.panel {
		display: grid;
		gap: var(--space-5);
	}

	/* .panel'in kendi display:grid'i, [hidden]'ın varsayılan display:none'ını ezer — açıkça geri kazandırıyoruz */
	.panel[hidden] {
		display: none;
	}

	.eyebrow {
		margin: 0 0 var(--space-2);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--color-accent-strong);
	}

	.panel h3 {
		margin: 0 0 var(--space-3);
		font-size: var(--text-3xl);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		color: var(--color-ink);
	}

	.description {
		max-width: 46ch;
		margin: 0 0 var(--space-5);
		color: var(--color-steel);
	}

	.cta {
		display: inline-block;
		padding: var(--space-2) var(--space-5);
		border: 1px solid var(--color-accent);
		border-radius: var(--radius-sm);
		color: var(--color-accent-strong);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		text-decoration: none;
		transition:
			background var(--transition),
			color var(--transition);
	}

	.cta:hover {
		background: var(--color-accent);
		color: var(--color-on-accent);
	}

	.visual {
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-md);
		background: linear-gradient(135deg, var(--color-field), var(--color-steel));
	}

	.panel:nth-child(even) .visual {
		background: linear-gradient(315deg, var(--color-steel), var(--color-field));
	}

	@media (min-width: 900px) {
		.layout {
			grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
			gap: var(--space-7);
			align-items: start;
		}

		.list {
			display: block;
			border-bottom: 0;
			border-left: var(--border-hairline);
		}

		.item {
			flex-direction: column;
			gap: var(--space-1);
			padding: var(--space-3) var(--space-4);
			border-bottom: 0;
			border-left: 2px solid transparent;
			margin: 0 0 0 -1px;
		}

		.item.is-active {
			border-left-color: var(--color-accent);
		}

		.item .label {
			font-size: var(--text-lg);
		}

		.panel {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
			gap: var(--space-6);
			align-items: center;
		}
	}
</style>

<script>
	const section = document.querySelector('[data-business-lines]');

	if (section) {
		const items = section.querySelectorAll('.item');
		const panels = section.querySelectorAll('.panel');

		const setActive = (index) => {
			items.forEach((item, i) => {
				const active = i === index;
				item.classList.toggle('is-active', active);
				if (active) item.setAttribute('aria-current', 'true');
				else item.removeAttribute('aria-current');
			});

			panels.forEach((panel, i) => {
				panel.hidden = i !== index;
			});
		};

		items.forEach((item, index) => {
			item.addEventListener('click', () => setActive(index));
		});
	}
</script>
