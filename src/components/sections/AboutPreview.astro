<section class="about-preview">
	<div class="row">
		<div class="text">
			<h2>Hakkımızda</h2>
			<p>
				Mekanik ve tarım sektöründe edindiğimiz saha deneyimiyle projeleri baştan sona güvenle
				teslim ediyoruz. Ekibimiz, planlamadan uygulamaya kadar her aşamada yanınızda.
			</p>
			<a class="link" href="/hakkimizda">Devamını Oku →</a>
		</div>

		<div class="gallery" aria-hidden="true">
			<div class="carousel" id="about-carousel">
				<div class="carousel-item item-main"></div>
				<div class="stack">
					<div class="carousel-item item-a"></div>
					<div class="carousel-item item-b"></div>
				</div>
			</div>
			<div class="progress-track">
				<div class="progress-fill" id="about-progress"></div>
			</div>
		</div>
	</div>
</section>

<script>
	const carousel = document.getElementById('about-carousel');
	const fill = document.getElementById('about-progress');

	if (carousel && fill) {
		const updateProgress = () => {
			const max = carousel.scrollWidth - carousel.clientWidth;
			const ratio = max > 0 ? carousel.scrollLeft / max : 0;
			fill.style.width = `${ratio * 100}%`;
		};

		carousel.addEventListener('scroll', updateProgress, { passive: true });
		updateProgress();
	}
</script>

