---
import { getAboutPage } from "../../lib/queries";
import Arrow from "../ui/Arrow.astro";
const about = await getAboutPage();
---

<section class="section about-preview" id="yaklasim">
  <div class="wrap">
    <div class="section-top">
      <p class="eyebrow">Bizi tanıyın</p>
      <span class="section-index">01 / YAKLAŞIMIMIZ</span>
    </div>
    <div class="about-layout">
      <div class="about-copy" data-reveal>
        <h2>{about?.heroTitle || "Her iyi proje, sahayı anlamakla başlar."}</h2>
        <p>{about?.heroDescription}</p>
        <a class="text-link" href="/hakkimizda">
          Hikâyemizi keşfedin <Arrow />
        </a>
        <div class="small-note">
          <span>↳</span>
          <p>
            İhtiyacı anlayan planlama.
            <br />
            Sahada karşılığı olan çözümler.
          </p>
        </div>
      </div>
      <div class="collage" data-reveal>
        <figure class="photo main-photo">
          <img
            src="/images/engineering.jpg"
            width="1400"
            height="927"
            alt="Bir inşaat sahasında birlikte çalışan uygulama ekibi"
            loading="lazy"
          />
        </figure>
        <figure class="photo small-photo">
          <img
            src="/images/agriculture.jpg"
            width="2200"
            height="1238"
            alt="Sıra halinde yetişen tarım bitkileri"
            loading="lazy"
          />
        </figure>
        <figure class="photo detail-photo">
          <img
            src="/images/installation.jpg"
            width="1200"
            height="800"
            alt="Teknik çizimler üzerinde çalışan proje uzmanı"
            loading="lazy"
          />
        </figure>
        <div class="collage-mark" aria-hidden="true">
          +
        </div>
        <p class="collage-caption">
          SAHADAN İLHAM ALIYORUZ. <span>Temsili görseller</span>
        </p>
      </div>
    </div>
  </div>
</section>
<style>
  .about-layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(45px, 7vw, 110px);
    align-items: center;
  }
  .about-copy h2 {
    font-size: clamp(34px, 3.8vw, 57px);
  }
  .about-copy > p {
    font-size: 13px;
    line-height: 1.9;
    max-width: 360px;
    margin-top: 30px;
  }
  .about-copy > .text-link {
    margin-top: 28px;
  }
  .small-note {
    display: flex;
    gap: 20px;
    margin-top: 55px;
    align-items: start;
  }
  .small-note > span {
    color: var(--color-accent);
    font-size: 25px;
    line-height: 1;
  }
  .small-note p {
    font-size: 10px;
    line-height: 1.8;
  }
  .collage {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    grid-template-rows: 220px 210px;
    gap: 16px;
    position: relative;
    padding-block: 35px;
  }
  .main-photo {
    grid-row: 1/3;
  }
  .main-photo img {
    object-position: 53% center;
  }
  .small-photo {
    margin-top: -35px;
    margin-bottom: 0;
  }
  .detail-photo {
    margin-bottom: 35px;
  }
  .collage-mark {
    position: absolute;
    bottom: 40px;
    right: -14px;
    color: var(--color-accent);
    font-size: 100px;
    font-weight: 400;
    line-height: 1;
  }
  .collage-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    font-size: 8px;
    letter-spacing: 0.11em;
    width: 100%;
    display: flex;
    justify-content: space-between;
  }
  .collage-caption span {
    font-size: 8px;
    letter-spacing: 0;
  }
  @media (max-width: 850px) {
    .about-layout {
      grid-template-columns: 1fr;
    }
    .about-copy {
      max-width: 650px;
    }
    .about-copy > p {
      max-width: 480px;
    }
    .small-note {
      display: none;
    }
    .collage {
      max-width: 650px;
      width: 100%;
      grid-template-rows: 230px 200px;
      margin-top: 15px;
    }
  }
  @media (max-width: 500px) {
    .collage {
      grid-template-rows: 160px 150px;
      gap: 10px;
    }
    .collage-mark {
      font-size: 70px;
      right: -9px;
    }
    .collage-caption {
      font-size: 7px;
    }
  }
  @media (max-width: 700px) {
    .about-copy > p {
      font-size: 14px;
    }
  }
</style>
