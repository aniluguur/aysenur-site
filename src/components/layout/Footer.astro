---
import { getSiteSettings } from '../../lib/queries';

const year = new Date().getFullYear();
const siteSettings = await getSiteSettings();
const companyName = siteSettings?.companyName ?? 'Şirket Adı';
const footerTagline = siteSettings?.footerTagline ?? '';
const socialLinks = siteSettings?.socialLinks ?? [];
---

<footer class="footer">
	<div class="inner">
		<div class="brand-block">
			<p class="brand">{companyName}</p>
			<p class="tagline">{footerTagline}</p>
		</div>

		<nav class="social" aria-label="Sosyal medya">
			<p class="social-title">Bizi Takip Edin</p>
			<ul>
				{
					socialLinks.map((link) => (
						<li>
							<a href={link.url}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>

	<div class="bottom">
		<p>&copy; {year} {companyName}. Tüm hakları saklıdır.</p>
	</div>
</footer>

<style>
	.footer {
		margin-top: var(--space-9);
		background: var(--color-ink);
		color: var(--color-on-dark);
	}

	.inner,
	.bottom {
		max-width: var(--container);
		margin-inline: auto;
		padding-inline: var(--container-pad);
	}

	.inner {
		display: grid;
		gap: var(--space-6);
		padding-block: var(--space-7);
	}

	.brand {
		margin: 0 0 var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
	}

	.tagline {
		max-width: 34ch;
		margin: 0;
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
		color: var(--color-steel-light);
	}

	.social-title {
		margin: 0 0 var(--space-3);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--color-harvest);
	}

	.social ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.social a {
		font-size: var(--text-sm);
		color: var(--color-on-dark);
		text-decoration: none;
	}

	.social a:hover {
		color: var(--color-harvest);
	}

	.bottom {
		padding-block: var(--space-4);
		border-top: 1px solid rgba(241, 237, 229, 0.16);
	}

	.bottom p {
		margin: 0;
		font-size: var(--text-xs);
		color: var(--color-steel-light);
	}

	@media (min-width: 900px) {
		.inner {
			grid-template-columns: 1fr auto;
			align-items: start;
			padding-block: var(--space-8);
		}

		.social ul {
			flex-direction: column;
			gap: var(--space-2);
		}
	}
</style>
