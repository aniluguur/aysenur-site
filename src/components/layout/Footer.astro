---
import { getSiteSettings, getCategories } from "../../lib/queries";
import BrandMark from "../ui/BrandMark.astro";
import Arrow from "../ui/Arrow.astro";
const [settings, categories] = await Promise.all([
  getSiteSettings(),
  getCategories(),
]);
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-main">
      <div class="footer-brand">
        <a href="/" class="brand">
          <BrandMark />
          <span>{settings?.companyName || "Şirket Adı"}</span>
        </a>
        <p>{settings?.footerTagline}</p>
        <span class="footer-note">İyi planlanır. Özenle uygulanır.</span>
      </div>
      <nav aria-label="Kurumsal bağlantılar">
        <p class="footer-label">KEŞFEDİN</p>
        <a href="/hakkimizda">Biz kimiz</a>
        <a href="/ne-yapiyoruz">Ne yapıyoruz</a>
        <a href="/projeler">Projelerimiz</a>
        <a href="/iletisim">İletişim</a>
      </nav>
      <nav aria-label="Sektör bağlantıları">
        <p class="footer-label">SEKTÖRLER</p>
        {categories.map((c) => (
          <a href={`/${c.slug}/`}>{c.title}</a>
        ))}
      </nav>
      <nav aria-label="Sosyal medya">
        <p class="footer-label">TAKİP EDİN</p>
        {settings?.socialLinks?.map((link) => (
          <a class="social-link" href={link.url}>
            {link.label}
            <Arrow />
          </a>
        ))}
      </nav>
    </div>
    <div class="footer-bottom">
      <span>
        © {new Date().getFullYear()} {settings?.companyName}. Tüm hakları
        saklıdır.
      </span>
      <a href="#main">Başa dön ↑</a>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    background: #1d251f;
    color: var(--color-on-dark);
    padding-top: 80px;
  }
  .footer-main {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 50px;
    padding-bottom: 76px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.05em;
  }
  .footer-brand p {
    color: #a9b1a7;
    font-size: 13px;
    max-width: 260px;
    margin-top: 24px;
  }
  .footer-note {
    display: block;
    margin-top: 28px;
    font-size: 10px;
    letter-spacing: 0.07em;
    color: #a9b1a7;
  }
  .footer-label {
    font-size: 9px;
    letter-spacing: 0.17em;
    color: #a9b1a7;
    margin: 5px 0 25px;
  }
  .footer-main nav > a {
    display: block;
    font-size: 12px;
    margin-bottom: 15px;
  }
  .footer-main nav > a:hover {
    color: #deb999;
  }
  .footer-bottom {
    padding-block: 22px;
    border-top: 1px solid #ffffff24;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 9px;
    color: #a9b1a7;
  }
  .social-link {
    display: flex !important;
    justify-content: space-between;
    max-width: 125px;
  }
  .social-link :global(svg) {
    width: 14px;
    height: 14px;
  }
  @media (max-width: 800px) {
    .footer-main {
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
    }
    .footer-brand {
      grid-column: 1/-1;
    }
    .footer-brand p {
      max-width: 400px;
    }
  }
  @media (max-width: 480px) {
    .site-footer {
      padding-top: 55px;
    }
    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 35px;
    }
    .footer-main nav:last-child {
      grid-column: 1/-1;
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }
    .footer-main nav:last-child .footer-label {
      width: 100%;
      margin-bottom: 0;
    }
    .social-link {
      gap: 12px;
    }
    .footer-bottom {
      align-items: flex-start;
    }
    .footer-bottom span {
      max-width: 230px;
    }
  }
</style>
