---
import { getCategories, getSiteSettings } from "../../lib/queries";
import BrandMark from "../ui/BrandMark.astro";
import Arrow from "../ui/Arrow.astro";
const [categories, settings] = await Promise.all([
  getCategories(),
  getSiteSettings(),
]);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const active = (href: string) =>
  path === href || (href !== "/" && path.startsWith(`${href}/`));
---

<header class="site-header" data-header>
  <div class="header-inner wrap">
    <a
      href="/"
      class="brand"
      aria-label={`${settings?.companyName || "Şirket Adı"} — Ana sayfa`}
    >
      <BrandMark />
      <span>
        {settings?.companyName || "Şirket Adı"}
        <small>MEKANİK · TARIM</small>
      </span>
    </a>
    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="main-navigation"
      aria-label="Menüyü aç"
      data-menu-toggle
    >
      <span></span>
      <span></span>
    </button>
    <nav id="main-navigation" aria-label="Ana menü" class="navigation">
      <a
        href="/hakkimizda"
        aria-current={active("/hakkimizda") ? "page" : undefined}
      >
        Biz kimiz
      </a>
      <a
        href="/ne-yapiyoruz"
        aria-current={active("/ne-yapiyoruz") ? "page" : undefined}
      >
        Ne yapıyoruz
      </a>
      <div class="nav-dropdown" data-dropdown>
        <button
          class:list={[
            "sector-trigger",
            { current: categories.some((c) => active(`/${c.slug}`)) },
          ]}
          aria-expanded="false"
          aria-controls="sector-menu"
          data-sector-trigger
        >
          Sektörler{" "}
          <svg
            width="12"
            height="12"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <path d="m2 4 4 4 4-4" stroke="currentColor" />
          </svg>
        </button>
        <div id="sector-menu" class="sector-menu" hidden>
          <p class="eyebrow">Çalıştığımız alanlar</p>
          {categories.map((category, index) => (
            <a
              href={`/${category.slug}/`}
              aria-current={active(`/${category.slug}`) ? "page" : undefined}
            >
              <span>
                <small>0{index + 1}</small>
                {category.title}
              </span>
              <Arrow />
            </a>
          ))}
        </div>
      </div>
      <a
        href="/projeler"
        aria-current={active("/projeler") ? "page" : undefined}
      >
        Projeler
      </a>
      <a
        class="header-cta"
        href="/iletisim"
        aria-current={active("/iletisim") ? "page" : undefined}
      >
        Birlikte çalışalım <Arrow />
      </a>
    </nav>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
    transition: box-shadow 0.3s;
  }
  .site-header.scrolled {
    box-shadow: 0 5px 25px #20292208;
  }
  .header-inner {
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .brand {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-shrink: 0;
  }
  .brand > span {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1.15;
  }
  .brand small {
    display: block;
    font-size: 7px;
    letter-spacing: 0.2em;
    margin-top: 7px;
    font-weight: 600;
  }
  .navigation {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.4vw, 40px);
  }
  .navigation > a,
  .sector-trigger {
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }
  .navigation a[aria-current="page"],
  .current {
    color: var(--color-accent);
  }
  .navigation > a:hover,
  .sector-trigger:hover {
    color: var(--color-accent);
  }
  .sector-trigger {
    display: flex;
    align-items: center;
    gap: 9px;
    background: none;
    border: none;
    padding: 20px 0;
  }
  .sector-trigger svg {
    transition: transform 0.3s;
  }
  .sector-trigger[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
  .nav-dropdown {
    position: relative;
  }
  .sector-menu {
    position: absolute;
    top: calc(100% + 17px);
    left: -30px;
    width: 320px;
    background: var(--color-surface);
    padding: 28px 30px;
    box-shadow: 0 24px 40px #20292216;
    border: 1px solid var(--color-line);
  }
  .sector-menu .eyebrow {
    margin-bottom: 18px;
    font-size: 9px;
  }
  .sector-menu > a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-line);
    padding: 17px 0;
    font-size: 20px;
  }
  .sector-menu small {
    font-size: 9px;
    margin-right: 15px;
    color: var(--color-steel);
  }
  .header-cta {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 14px 18px;
    border: 1px solid var(--color-line);
  }
  .header-cta :global(svg) {
    width: 17px;
    height: 17px;
  }
  .menu-toggle {
    display: none;
  }
  .sector-menu a:hover {
    color: var(--color-accent);
  }
  @media (max-width: 1000px) {
    .header-inner {
      gap: 18px;
    }
    .navigation {
      gap: 20px;
    }
    .brand > span {
      font-size: 18px;
    }
    .header-cta {
      padding: 12px;
      gap: 14px;
    }
  }
  @media (max-width: 850px) {
    .menu-toggle {
      display: flex;
      flex-direction: column;
      gap: 6px;
      width: 44px;
      height: 44px;
      justify-content: center;
      align-items: center;
      border: 1px solid var(--color-line);
      background: none;
    }
    .menu-toggle span {
      width: 18px;
      height: 1px;
      background: currentColor;
      transition: transform 0.25s;
    }
    .menu-toggle[aria-expanded="true"] span:first-child {
      transform: translateY(3.5px) rotate(45deg);
    }
    .menu-toggle[aria-expanded="true"] span:last-child {
      transform: translateY(-3.5px) rotate(-45deg);
    }
    .navigation {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: calc(100dvh - var(--header-height));
      overflow: auto;
      padding: 24px var(--gutter) 40px;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-line);
    }
    .site-header.nav-open .navigation {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .navigation > a,
    .sector-trigger {
      font-size: 24px;
      font-weight: 400;
      padding: 20px 0;
      border-bottom: 1px solid var(--color-line);
      width: 100%;
    }
    .sector-trigger {
      justify-content: space-between;
    }
    .sector-menu {
      position: static;
      box-shadow: none;
      border: 0;
      width: 100%;
      padding: 20px 0 10px 20px;
    }
    .sector-menu .eyebrow {
      display: none;
    }
    .sector-menu > a {
      font-size: 20px;
    }
    .header-cta {
      margin-top: 25px;
      padding: 20px !important;
      font-size: 15px !important;
      justify-content: space-between;
    }
    .brand > span {
      font-size: 20px;
    }
  }
</style>
<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    const toggle =
      header.querySelector<HTMLButtonElement>("[data-menu-toggle]")!;
    const trigger = header.querySelector<HTMLButtonElement>(
      "[data-sector-trigger]",
    )!;
    const menu = header.querySelector<HTMLElement>("#sector-menu")!;
    const nav = header.querySelector<HTMLElement>(".navigation")!;
    const setSector = (open: boolean) => {
      trigger.setAttribute("aria-expanded", String(open));
      menu.hidden = !open;
    };
    const setNav = (open: boolean) => {
      header.classList.toggle("nav-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Menüyü kapat" : "Menüyü aç");
      document.body.classList.toggle("menu-open", open);
      if (!open) setSector(false);
    };
    toggle.addEventListener("click", () =>
      setNav(toggle.getAttribute("aria-expanded") !== "true"),
    );
    trigger.addEventListener("click", () => setSector(menu.hidden));
    document.addEventListener("click", (event) => {
      if (!header.contains(event.target as Node)) {
        setSector(false);
        setNav(false);
      }
    });
    header.addEventListener("focusout", (event) => {
      if (!header.contains(event.relatedTarget as Node)) setSector(false);
    });
    header.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        if (!menu.hidden) {
          setSector(false);
          trigger.focus();
        } else {
          setNav(false);
          toggle.focus();
        }
      }
      if (event.key === "Tab" && header.classList.contains("nav-open")) {
        const items = [
          toggle,
          ...Array.from(nav.querySelectorAll<HTMLElement>("a,button")).filter(
            (el) => el.getClientRects().length > 0,
          ),
        ];
        if (event.shiftKey && document.activeElement === items[0]) {
          event.preventDefault();
          items.at(-1)?.focus();
        } else if (!event.shiftKey && document.activeElement === items.at(-1)) {
          event.preventDefault();
          toggle.focus();
        }
      }
    });
    window
      .matchMedia("(min-width:851px)")
      .addEventListener("change", () => setNav(false));
    const onScroll = () =>
      header.classList.toggle("scrolled", window.scrollY > 20);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
