---
import BaseLayout from "../layouts/BaseLayout.astro";
import Arrow from "../components/ui/Arrow.astro";
---

<BaseLayout title="Sayfa Bulunamadı">
  <section class="not-found wrap">
    <p class="eyebrow">404 / Sayfa bulunamadı</p>
    <h1>
      Bu yol başka
      <br />
      bir yere çıkıyor.
    </h1>
    <p>
      Aradığınız sayfa taşınmış veya kaldırılmış olabilir.
      <br />
      Projelerimizden devam edebilirsiniz.
    </p>
    <div>
      <a class="button" href="/">
        Ana sayfaya dön <Arrow />
      </a>
      <a class="text-link" href="/projeler">
        Projeleri keşfet <Arrow />
      </a>
    </div>
  </section>
</BaseLayout>
<style>
  .not-found {
    padding-block: 100px 130px;
  }
  .not-found h1 {
    margin-top: 35px;
  }
  .not-found > p:not(.eyebrow) {
    margin-top: 30px;
    font-size: 14px;
  }
  .not-found > div {
    display: flex;
    gap: 30px;
    align-items: center;
    margin-top: 35px;
  }
  @media (max-width: 600px) {
    .not-found {
      padding-block: 65px;
    }
    .not-found > div {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
