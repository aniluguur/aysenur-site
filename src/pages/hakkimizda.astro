---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAboutPage } from "../lib/queries";
import ContactCta from "../components/sections/ContactCta.astro";
const about = await getAboutPage();
---

<BaseLayout
  title="Biz Kimiz — Sahadan Gelen Deneyim"
  description={about?.heroDescription}
>
  <section class="page-intro wrap">
    <p class="eyebrow">{about?.heroEyebrow || "Biz kimiz"}</p>
    <h1>{about?.heroTitle}</h1>
    <p class="lead">{about?.heroDescription}</p>
  </section>
  <figure class="photo cover-wide">
    <img
      src="/images/engineering.jpg"
      width="1400"
      height="927"
      alt="Birlikte çalışan saha uygulama ekibi"
      fetchpriority="high"
    />
    <span class="photo-credit">Temsili saha görseli</span>
  </figure>
  <section class="section wrap story-layout">
    <div data-reveal>
      <p class="eyebrow">Hikâyemiz</p>
      <h2>
        İşe yakın.
        <br />
        İnsana yakın.
      </h2>
    </div>
    <div class="prose" data-reveal>
      {about?.storyParagraphs?.map((p) => (
        <p>{p}</p>
      ))}
    </div>
  </section>
  <section class="values-section section">
    <div class="wrap">
      <div class="section-top">
        <p class="eyebrow">Bizi bir arada tutanlar</p>
        <span class="section-index">DEĞERLERİMİZ</span>
      </div>
      <div class="values-grid">
        {about?.values?.map((value, index) => (
          <article data-reveal>
            <span class="value-number">0{index + 1}</span>
            <h3>{value.title}</h3>
            <p>{value.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <ContactCta />
</BaseLayout>
<style>
  .story-layout {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 80px;
  }
  .story-layout h2 {
    margin-top: 30px;
  }
  .prose p {
    font-size: 15px;
  }
  .values-section {
    background: var(--color-surface-alt);
  }
  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 35px;
  }
  .value-number {
    font-size: 11px;
    color: var(--color-accent);
  }
  .values-grid h3 {
    font-size: 27px;
    margin-top: 40px;
    margin-bottom: 23px;
  }
  .values-grid p {
    font-size: 12px;
    line-height: 1.9;
  }
  @media (max-width: 850px) {
    .story-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .values-grid {
      grid-template-columns: 1fr 1fr;
      gap: 45px 30px;
    }
  }
  @media (max-width: 480px) {
    .values-grid {
      grid-template-columns: 1fr;
    }
    .values-grid article {
      border-top: 1px solid var(--color-line);
      padding-top: 18px;
    }
    .values-grid h3 {
      margin-top: 20px;
    }
  }
</style>
