---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects } from "../../lib/queries";
import { imageUrl, projectImage, projectDate } from "../../lib/media";
import ProjectDescription from "../../components/ui/ProjectDescription.astro";
import ContactCta from "../../components/sections/ContactCta.astro";
import ProjectCard from "../../components/projects/ProjectCard.astro";
import Arrow from "../../components/ui/Arrow.astro";
export async function getStaticPaths() {
  const all = await getProjects();
  return all.map((project) => ({
    params: { slug: project.slug },
    props: {
      project,
      related: all
        .filter(
          (p) =>
            p.slug !== project.slug &&
            p.category?.slug === project.category?.slug,
        )
        .slice(0, 2),
    },
  }));
}
const { project, related } = Astro.props;
const date = projectDate(project.projectDate);
const gallery = (project.gallery || []).filter((image) => image?.asset);
---

<BaseLayout title={project.title} description={project.shortDescription}>
  <section class="wrap page-intro">
    <nav class="breadcrumb" aria-label="Sayfa yolu">
      <a href="/">Ana sayfa</a>
      <span>/</span>
      <a href="/projeler">Projeler</a>
      {project.category && (
        <>
          <span>/</span>
          <a href={`/${project.category.slug}/`}>{project.category.title}</a>
        </>
      )}
    </nav>
    <p class="eyebrow">{project.category?.title || "Proje & uygulama"}</p>
    <h1>{project.title}</h1>
    <div class="project-meta">
      {project.location && <span>{project.location}</span>}
      {date && <span>{date}</span>}
    </div>
  </section>
  <figure class="photo cover-wide">
    <img
      src={imageUrl(
        project.coverImage,
        2200,
        projectImage(project.slug, project.category?.slug),
      )}
      alt={
        project.coverImage?.alt ||
        (project.coverImage?.asset
          ? project.title
          : "Çalışma alanını temsil eden görsel")
      }
      width="2200"
      height="1400"
      fetchpriority="high"
    />
    {!project.coverImage?.asset && (
      <span class="photo-credit">
        Temsili görsel — projeye ait fotoğraf henüz eklenmedi
      </span>
    )}
  </figure>
  <section class="section wrap project-body">
    <aside>
      <p class="eyebrow">Proje hakkında</p>
      {project.technicalInfo?.length > 0 && (
        <dl class="technical-info">
          {project.technicalInfo.map((info) => (
            <div>
              <dt>{info.label}</dt>
              <dd>{info.value}</dd>
            </div>
          ))}
        </dl>
      )}
      <a href="/iletisim" class="text-link">
        Benzer bir projeniz mi var? <Arrow />
      </a>
    </aside>
    <div>
      <p class="project-lead">{project.shortDescription}</p>
      <ProjectDescription value={project.description} />
    </div>
  </section>
  {gallery.length > 0 && (
    <section class="wrap gallery-section">
      <div class="section-top">
        <p class="eyebrow">Sahadan detaylar</p>
        <span class="section-index">PROJE GALERİSİ</span>
      </div>
      <div class="project-gallery">
        {gallery.map((photo, index) => (
          <figure class="photo" data-reveal>
            <img
              src={imageUrl(photo, 1400)}
              alt={photo.alt || `${project.title} — ${index + 1}. görsel`}
              width="1400"
              height="1000"
              loading="lazy"
            />
          </figure>
        ))}
      </div>
    </section>
  )}
  {related.length > 0 && (
    <section class="section wrap">
      <div class="section-top">
        <p class="eyebrow">Diğer çalışmalarımız</p>
        <a class="text-link" href="/projeler">
          Tüm projeler <Arrow />
        </a>
      </div>
      <div class="project-grid">
        {related.map((p, index) => (
          <ProjectCard project={p} index={index} />
        ))}
      </div>
    </section>
  )}
  <ContactCta />
</BaseLayout>
<style>
  .project-meta {
    display: flex;
    gap: 30px;
    font-size: 12px;
    color: var(--color-steel);
    margin-top: 35px;
  }
  .project-meta span + span {
    border-left: 1px solid var(--color-line);
    padding-left: 30px;
  }
  .project-body {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 100px;
  }
  .technical-info {
    margin-top: 35px;
  }
  .technical-info > div {
    border-top: 1px solid var(--color-line);
    padding-block: 16px;
  }
  .technical-info dt {
    font-size: 9px;
    color: var(--color-steel);
    margin-bottom: 7px;
  }
  .technical-info dd {
    font-size: 13px;
    margin: 0;
  }
  .project-body aside > .text-link {
    font-size: 10px;
    margin-top: 20px;
  }
  .project-lead {
    font-size: 25px;
    line-height: 1.5;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    margin-bottom: 35px;
  }
  .project-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .project-gallery > .photo {
    aspect-ratio: 1.35;
  }
  .project-gallery > .photo:first-child:nth-last-child(odd) {
    grid-column: 1/-1;
    aspect-ratio: 2;
  }
  .gallery-section {
    padding-bottom: 70px;
  }
  @media (max-width: 850px) {
    .project-body {
      grid-template-columns: 1fr;
      gap: 50px;
    }
    .project-body aside {
      order: 2;
    }
    .technical-info {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 25px;
    }
    .project-lead {
      font-size: 22px;
    }
  }
  @media (max-width: 550px) {
    .project-gallery {
      grid-template-columns: 1fr;
    }
    .project-gallery > .photo:first-child:nth-last-child(odd) {
      aspect-ratio: 1.35;
    }
    .project-meta {
      font-size: 10px;
    }
  }
</style>
